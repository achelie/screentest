{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screentesthub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": false
    }
  },
  // Publish only the current deployment. Keeping versioned Preview URLs off
  // prevents older builds with the prefetch retry bug from remaining public.
  "workers_dev": true,
  "preview_urls": false
}
