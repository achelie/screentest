{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screentesthub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": false
    }
  },
  // The fixed workers.dev hostname was targeted by automated traffic. Keep it
  // disabled and use the unguessable versioned Preview URL until the custom
  // domain is protected by zone-level security rules.
  "workers_dev": false,
  "preview_urls": true
}
